<?xml version="1.0" encoding="UTF-8"?>
<timers>
    <timer>
        <name>splashtest_autotime</name>
        <description>Advance the splash preview by one hour every three seconds.</description>
        <!-- Timers are loaded directly, without the includes expression expansion pass. -->
        <start reset="true">Window.IsVisible(1191) + String.IsEqual(Window(1191).Property(SplashTest.AutoTime),true)</start>
        <stop>!Window.IsVisible(1191) | !String.IsEqual(Window(1191).Property(SplashTest.AutoTime),true) | Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(splashtest_autotime),3)</stop>
        <onstop condition="Window.IsVisible(1191) + String.IsEqual(Window(1191).Property(SplashTest.AutoTime),true)">SetProperty(SplashTest.Hour,$VAR[Value_StartUp_Test_NextHour],1191)</onstop>
    </timer>
    <timer>
        <name>auto_skin_login</name>
        <description>Return to the configured login screen after 30 minutes of inactivity.</description>
        <start reset="true">System.LoggedOn + !Window.IsVisible(1195) + !Window.IsVisible(loginscreen) + !System.HasVisibleModalDialog + [!Player.HasMedia | Player.Paused] + [!Skin.HasSetting(SkinUserLogin.Disabled) | System.HasLoginScreen] + System.IdleTime(1800)</start>
        <stop>Window.IsVisible(1195) | Window.IsVisible(loginscreen) | !System.LoggedOn | !System.IdleTime(1) | [Player.HasMedia + !Player.Paused]</stop>
        <onstart condition="Skin.HasSetting(SkinUserLogin.Disabled)">System.LogOff</onstart>
        <onstart condition="!Skin.HasSetting(SkinUserLogin.Disabled)">ActivateWindow(1195)</onstart>
    </timer>
</timers>
